# Canonical origin for this deployment — no trailing slash.
# Every canonical tag, sitemap URL and og:image absolute URL is built from it.
# Set this in your host's environment (Cloudflare Pages / Vercel / Netlify).
NEXT_PUBLIC_SITE_URL=https://sureride.in

# Set to 1 on any deploy that is NOT the production domain (staging, CloudFront
# preview URLs). Emits <meta name="robots" content="noindex"> and a
# Disallow-all robots.txt so the preview cannot cannibalise the real site.
NEXT_PUBLIC_NOINDEX=

# Release gates. Vehicle/destination imagery and driver portraits are separated
# so publishing one category cannot accidentally publish the other.
NEXT_PUBLIC_FARES_CONFIRMED=0
NEXT_PUBLIC_VEHICLE_RATES_CONFIRMED=1
NEXT_PUBLIC_SITE_PHOTOS_APPROVED=1
NEXT_PUBLIC_DRIVER_PHOTOS_APPROVED=0

# Optional Search Console HTML-tag verification token. Enter only the token,
# not the complete <meta> element. Domain-property DNS verification is preferred.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
